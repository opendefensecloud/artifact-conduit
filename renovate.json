{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>opendefensecloud/renovate-config",
    "github>opendefensecloud/renovate-config:go",
    "github>opendefensecloud/renovate-config:k8s"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["examples/*/cluster-workflow-template.yaml"],
      "matchStrings": [
        "image:\\s*(?<depName>[a-zA-Z0-9./_-]+):(?<currentValue>[a-zA-Z0-9._-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "ignorePaths": []
}
